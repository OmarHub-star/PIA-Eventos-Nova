# Genera valores locales con: python scripts/init_env.py
DATABASE_URL=sqlite:///./nova.db
SEED_DATA=true
# JSON token -> identidad. Sustituye cada texto por un token aleatorio distinto.
TOKENS_JSON={"CAMBIAR_ADMIN":{"id":"ADM-001","role":"ADMIN"},"CAMBIAR_COORD":{"id":"COORD-001","role":"COORDINADOR"},"CAMBIAR_CLIENTE":{"id":"EVE-C001","role":"CLIENTE"},"CAMBIAR_PROV":{"id":"PROV-001","role":"PROVEEDOR"},"CAMBIAR_BACKUP":{"id":"PROV-002","role":"PROVEEDOR"}}
POSTGRES_USER=nova
POSTGRES_PASSWORD=CAMBIAR_CON_PASSWORD_ALEATORIO
POSTGRES_DB=nova
PORT=8000
